<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Compile-only stand-in for the game's Assembly-CSharp.dll (see ci/README.md).
        The source in this folder is generated by ci/stubgen and declares only the API shape the
        plugin links against, so CI can build the plugin without a Graveyard Keeper install.
    -->
    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <AssemblyName>Assembly-CSharp</AssemblyName>
        <RootNamespace></RootNamespace>
        <!-- Has to match the shipped assembly so the plugin's AssemblyRef is unchanged. -->
        <AssemblyVersion>11.0.0.0</AssemblyVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <Deterministic>true</Deterministic>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <NoWarn>CS0649;CS0169;CS0067;CS0108;CS0114</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
        <ProjectReference Include="..\Assembly-CSharp-firstpass\Assembly-CSharp-firstpass.csproj" Private="false" />
    </ItemGroup>

</Project>
