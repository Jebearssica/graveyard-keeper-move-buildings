<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>MoveBuildings</AssemblyName>
    <RootNamespace>MoveBuildings</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- No debug symbols in the shipped assembly: PDB paths would embed local directories. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);Publicizer001</NoWarn>

    <BepInExPluginGuid>gk.movebuildings</BepInExPluginGuid>
    <BepInExPluginName>Move Buildings</BepInExPluginName>
    <BepInExPluginVersion>1.1.2</BepInExPluginVersion>
  </PropertyGroup>

  <!--
    Two ways to build.

    Against a real install (the default): the game directory is detected when this project sits inside it
    (for example <game>\mods-work\MoveBuildings), otherwise the default Steam location is used. Override with
    -p:GameDir="D:\Games\Graveyard Keeper"; the plugin is copied into the game when BepInEx is installed.

    Without a game install (what CI does):
        dotnet build -c Release -p:UseGameRefs=false -p:DeployToGame=false -p:BepInExCore=<extracted BepInEx>\core
    The game assemblies are replaced by the declaration-only stubs in ci/refs. See ci/README.md.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\..\Graveyard Keeper_Data\Managed\Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)..\..</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Graveyard Keeper</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\Graveyard Keeper_Data\Managed</ManagedDir>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameDir)\BepInEx\core</BepInExCore>

    <UseGameRefs Condition="'$(UseGameRefs)' == '' AND Exists('$(ManagedDir)\Assembly-CSharp.dll')">true</UseGameRefs>
    <UseGameRefs Condition="'$(UseGameRefs)' == ''">false</UseGameRefs>

    <DeployToGame Condition="'$(DeployToGame)' == '' AND Exists('$(GameDir)\BepInEx\plugins')">true</DeployToGame>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <!-- Keeps net481 buildable without the .NET Framework targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Against the real game, with the game assemblies publicized at build time only. -->
  <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Texture2D.LoadImage (ImageConversion) is used to decode the bundled row icon. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
    <Publicize Include="Assembly-CSharp" PublicizeTarget="All" />
  </ItemGroup>

  <!-- ci\ holds tooling and generated stubs, not plugin source. -->
  <ItemGroup>
    <Compile Remove="ci\**\*.cs" />
    <!--
      The stub projects keep their build output in ci\refs\*\bin|obj. Those DLLs must never be picked up by the
      compiler: RAR prefers "candidate assembly files" over Reference HintPaths, so a leftover stub assembly named
      Assembly-CSharp.dll would silently replace the real one.
    -->
    <None Remove="ci\**" />
    <Content Remove="ci\**" />
    <EmbeddedResource Remove="ci\**" />
  </ItemGroup>

  <!-- Recording helper for the README GIF; never part of a release build. -->
  <PropertyGroup Condition="'$(Demo)' == 'true'">
    <DefineConstants>$(DefineConstants);DEMO</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Demo)' != 'true'">
    <Compile Remove="Demo.cs" />
  </ItemGroup>

  <!-- Without the game: stubs for the game assemblies, Unity modules from NuGet. -->
  <ItemGroup Condition="'$(UseGameRefs)' != 'true'">
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
    <ProjectReference Include="ci\refs\Assembly-CSharp-firstpass\Assembly-CSharp-firstpass.csproj" Private="false" />
    <ProjectReference Include="ci\refs\Assembly-CSharp\Assembly-CSharp.csproj" Private="false" />
    <!--
      The stubs expose the used game members as public, so the access exemption is only needed when the
      build does not publicize the real assemblies (which bring their own copy of the attribute).
      Has to come after the Compile Remove above: MSBuild removes items no matter where they were added.
    -->
    <Compile Include="ci\IgnoresAccessChecksTo.cs" Link="Shared\IgnoresAccessChecksTo.cs" />
  </ItemGroup>

  <!-- Language of the extra row is resolved at runtime; the icon is a self-made 32x32 PNG in the vanilla palette. -->
  <ItemGroup>
    <EmbeddedResource Include="icon\move_building.png" LogicalName="MoveBuildings.icon.move_building.png" />
    <None Remove="icon\**" />
  </ItemGroup>

  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\MoveBuildings" />
  </Target>

</Project>







